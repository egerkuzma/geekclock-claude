# Your Claude.ai sessionKey cookie value.
# Get from claude.ai → DevTools → Application → Cookies → sessionKey
# Starts with sk-ant-sid01-...
CLAUDE_SESSION_KEY=sk-ant-sid01-REPLACE_ME

# Alternative: path to a file containing just the session key
# (used only if CLAUDE_SESSION_KEY is empty)
# CLAUDE_SESSION_KEY_FILE=~/.claude_session_key

# Optional: your organization UUID. Auto-detected on first run.
# Set it to skip the extra API call.
# CLAUDE_ORG_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# GeekMagic SmartPixel clock IP address on your LAN
GEEKCLOCK_IP=192.168.1.100

# How often to actually call claude.ai (seconds). Default 300.
# GEEKCLOCK_CACHE_TTL=300

# Where to keep the cache file
# GEEKCLOCK_CACHE_PATH=/tmp/geekclock_claude_cache.json
